/**
 * 版本号规则（唯一版本源）：
 *   versionName = 1.MMDD.NN   （MMDD=构建月日，NN=当日序号，从 01 开始）
 *   versionCode = MMDDNN 前补 1（即 1MMDDNN）
 *   buildVersion = versionCode（与版本号保持一致，如 1101303）
 * 例：2026-11-10 当日第 5 次构建 -> 1.1110.05 / 1111005 / build 1111005
 * 本地（DevEco / build_sign.ps1）与 CI（build-hap.yml）出包必须以此文件为准，
 * 三处版本号保持一致，不得各自修改。
 */
{
  "app": {
    "bundleName": "music.hm.op",
    "vendor": "伍修骏",
    "versionCode": 1111011,
    "versionName": "1.1110.11",
    "buildVersion": "1111011",
    "icon": "$media:layered_image",
    "label": "$string:app_name",
    "cloudFileSyncEnabled": true
  }
}
