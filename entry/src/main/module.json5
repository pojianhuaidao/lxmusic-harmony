{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      // 平板：界面已按窗口宽度自适应（底部两条悬浮栏的宽度、内容列的最大宽度都按窗口算，
      // 见 ui/Layout.ets 与 ui/Widgets.ets 的 WidePane）。不声明 tablet 的话，
      // 平板上只能跑手机的兼容模式：整屏被拉伸放大，字发虚、控件比例也不对
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET",
        "reason": "$string:reason_internet",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        // 后台播放：退到后台/息屏后进程要能继续跑，否则 AVPlayer 会被冻结停住
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING"
      }
      // 这里原本还声明了 ohos.permission.FILE_ACCESS_PERSIST（持久化目录授权），已去掉：
      // 它属于「受限 ACL 权限」，必须在签名 Profile 的 allowed-acls 里声明才能生效
      // （自动生成的调试 Profile 里没有，声明了也只是摆设，还会卡住 AGC 上传时的
      // 「ACL 权限声明一致性」校验）。而下载真正写文件走的是系统保存对话框
      // （DocumentViewPicker.save），那条路本来就不需要这个权限，见 openTarget。
      //
      // 关于「公共 Download 目录写权限」的两种候选方案（下载功能待办）：
      //   - 方案 A：声明受限 ACL 权限 ohos.permission.READ_WRITE_DOWNLOAD_DIRECTORY。
      //     不可行：受限 ACL 权限必须在签名 Profile 的 allowed-acls 中显式授权才能
      //     真正生效，本工程签名证书已申请吊销、无法生成带 allowed-acls 的 Profile；
      //     即使未来恢复签名，声明受限权限还会卡 AGC 上传的「ACL 权限声明一致性」
      //     校验，需额外走受限权限申请/审核。故不在本文件声明。
      //   - 方案 B：Picker 授权路径（选定方案）。DownloadManager 使用系统保存对话框
      //     的 DOWNLOAD 模式（DocumentViewPicker.save + DocumentPickerMode.DOWNLOAD），
      //     系统返回公共 Download/<包名>/ 目录 uri（自带持久化授权），应用拼文件名建
      //     文件，无需任何静态权限声明，兼容 API 12 起的全部手机/平板。已实现于
      //     DownloadManager.openViaPicker，设置页「下载目录」显示的就是该目录。
      //   - 应用数据根目录（LxMusicData）仍以直接读写公共 Download 目录为主、失败回退
      //     filesDir，见 core/common/StoragePaths.ets：写权限最终由签名 Profile 授权
      //     决定，try/catch 回退保证不因权限缺失而崩。
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        // 与上面的权限配套：声明这个 ability 会申请「音频播放」长时任务
        "backgroundModes": [
          "audioPlayback"
        ],
        // 平板/大屏全屏适配：显式声明支持「全屏 + 分屏 + 悬浮」三种窗口模式。
        // 注意：本 SDK schema 中 abilities **没有** windowSize / resizeable 字段
        // （允许项只有 maxWindowWidth/Height、minWindowWidth/Height 等），若配了
        // 固定初始尺寸，平板（11.5 寸）启动就会按那个手机尺寸开窗而不是铺满全屏，
        // 正是「不自动扩充整个屏幕」最常见的配置根因；不配 = 交给系统按设备屏幕
        // 全屏启动（窗口记忆/自由窗口残留的非全屏状态由 EntryAbility 启动时
        // setWindowMode 兜底）。
        "supportWindowMode": [
          "fullscreen",
          "split",
          "floating"
        ],
        // 华为帐号登录（AGC 认证服务 hwid）必需的 client_id 元数据：
        // @hw-agconnect/auth 通过 Ability 的 metadata 读取 client_id，缺失会
        // 导致 auth 实例初始化失败（Cannot read property currentUserInstance of undefined）
        "metadata": [
          {
            "name": "client_id",
            "value": "6917619028178838274"
          }
        ],
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ],
      }
    ]
  }
}