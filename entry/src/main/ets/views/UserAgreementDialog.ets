/**
 * 首启协议确认页组件
 *
 * @param onAccept 点「同意并继续」：壳层调 UserAgreement.accept() 落盘并关闭遮罩
 * @param onDecline 点「不同意」：壳层给提示（遮罩保持，不进入主界面）
 */
@Component
export struct UserAgreementDialog {
  onAccept: () => void = () => {
  };
  onDecline: () => void = () => {
  };

  build() {
    Stack() {
      // 半透明遮罩：盖住整屏（含状态栏/导航条区域，expandSafeArea 后铺满全窗口）
      Column()
        .width('100%')
        .height('100%')
        .backgroundColor('#B3000000')

      // 居中卡片：标题 + 可滚动文案 + 按钮行
      Column() {
        Column() {
          Text('欢迎使用')
            .fontSize(F_SECTION)
            .fontColor(C_TEXT_SUB)
          Text('用户协议与隐私政策')
            .fontSize(F_TITLE)
            .fontColor(C_TEXT)
            .fontWeight(FontWeight.Bold)
            .margin({ top: 6 })
        }
        .width('100%')
        .padding({ top: 22, bottom: 14 })
        .alignItems(HorizontalAlign.Center)

        Divider()
          .color(C_DIVIDER)

        // 文案区：上下两段可滚动阅读
        Scroll() {
          Column() {
            Text(AGREEMENT_TITLE)
              .fontSize(F_ITEM)
              .fontColor(C_TEXT)
              .fontWeight(FontWeight.Medium)
              .width('100%')
            Text(AGREEMENT_TEXT)
              .fontSize(F_SUB)
              .fontColor(C_TEXT_SUB)
              .lineHeight(19)
              .width('100%')
              .margin({ top: 8 })

            Divider()
              .color(C_DIVIDER)
              .margin({ top: 18, bottom: 18 })

            Text(PRIVACY_TITLE)
              .fontSize(F_ITEM)
              .fontColor(C_TEXT)
              .fontWeight(FontWeight.Medium)
              .width('100%')
            Text(PRIVACY_TEXT)
              .fontSize(F_SUB)
              .fontColor(C_TEXT_SUB)
              .lineHeight(19)
              .width('100%')
              .margin({ top: 8 })
          }
          .width('100%')
        }
        .width('100%')
        .layoutWeight(1)
        .scrollBar(BarState.Auto)
        .edgeEffect(EdgeEffect.Spring)
        .padding({ left: 18, right: 18, top: 10, bottom: 10 })

        Divider()
          .color(C_DIVIDER)

        Row() {
          Button('不同意')
            .fontSize(F_SUB)
            .fontColor(C_TEXT_SUB)
            .backgroundColor(C_CARD)
            .borderRadius(R_PILL)
            .layoutWeight(1)
            .onClick(() => {
              this.onDecline();
            })
          Button('同意并继续')
            .fontSize(F_SUB)
            .fontColor(Color.White)
            .backgroundColor($r('app.color.c_red'))
            .borderRadius(R_PILL)
            .layoutWeight(1)
            .margin({ left: 14 })
            .onClick(() => {
              this.onAccept();
            })
        }
        .width('100%')
        .padding({ left: 18, right: 18, top: 14, bottom: 16 })
      }
      .width('88%')
      .constraintSize({ maxHeight: '86%' })
      .backgroundColor(C_BG)
      .borderRadius(22)
      // 避开状态栏 / 导航条：全屏布局下遮罩铺满窗口，卡片留出安全区高度
      .margin({ top: 56, bottom: 56 })
    }
    .width('100%')
    .height('100%')
    .expandSafeArea([SafeAreaType.SYSTEM], [SafeAreaEdge.TOP, SafeAreaEdge.BOTTOM])
  }
}
